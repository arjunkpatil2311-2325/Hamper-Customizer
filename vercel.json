{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm --filter @workspace/api-server run build && corepack pnpm --filter @workspace/hamper-hub run build",
  "outputDirectory": "artifacts/hamper-hub/dist/public",
  "rewrites": [
    {
      "source": "/__clerk/:path*",
      "destination": "/api/index?__vercel_rewrite_path=__clerk/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__vercel_rewrite_path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
