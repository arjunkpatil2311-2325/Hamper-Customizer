modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[objectStorage]
defaultBucketID = "replit-objstore-dc557f3f-0b8f-4df0-a0f4-0c23cca178df"

[userenv]

[userenv.shared]
HAMPER_HUB_ADMIN_EMAIL = "arjun.kpatil2311@gmail.com"
